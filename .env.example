# Clerk Publishable Key (safe to expose in the client).
# Get it from https://dashboard.clerk.com -> API keys -> Quick Copy.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxx

# Supabase URL + publishable (anon) key (safe to expose in the client).
# Get them from https://supabase.com/dashboard -> your project -> Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx
