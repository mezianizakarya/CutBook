{
  "expo": {
    "name": "KUTZ",
    "slug": "kutz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/kutz-app-icons/ios/AppIcon.appiconset/Icon-1024.png",
    "scheme": "kutz",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/kutz-app-icons/ios/AppIcon.appiconset/Icon-1024.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FABA23",
        "foregroundImage": "./assets/kutz-app-icons/ios/AppIcon.appiconset/Icon-1024.png"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow KUTZ to access your photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow KUTZ to use your location to find barbers nearby and set your shop's address."
        }
      ],
      [
        "@clerk/expo",
        {
          "appleSignIn": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
